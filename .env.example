# Database — same connection string used by lekha-api (no migrations run here)
DATABASE_URL="postgresql://user:password@host:5432/lekha_db?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/lekha_db?schema=public"

# Supabase JWT secret (Supabase dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Server
PORT=3002
API_PREFIX=api
NODE_ENV=development
